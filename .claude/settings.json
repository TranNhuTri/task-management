{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_english.sh\"",
            "timeout": 15,
            "statusMessage": "Checking file language..."
          }
        ]
      }
    ]
  }
}
